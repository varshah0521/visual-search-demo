# Copy to .env and fill in real values. Never commit .env.

# WooCommerce REST API (Settings > Advanced > REST API, read access is enough)
WC_BASE_URL=https://your-store.example.com
WC_CONSUMER_KEY=ck_replace_with_your_consumer_key
WC_CONSUMER_SECRET=cs_replace_with_your_consumer_secret

# Catalog paging: WC_PER_PAGE * WC_MAX_PAGES products get indexed
WC_PER_PAGE=10
WC_MAX_PAGES=5

# Hugging Face access token, needed for gated model weights (e.g. DINOv3)
HF_TOKEN=hf_replace_with_your_token
